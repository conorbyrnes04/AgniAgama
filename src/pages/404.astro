---
import Base from '../layouts/Base.astro';
import { defaultLocale, localize, useTranslations } from '../i18n';

// Static hosts serve one 404 for every path, so this page stays in the default
// language (a localized /fr/404 would never actually be reached).
const lang = defaultLocale;
const t = useTranslations(lang);
---
<Base lang={lang} title={t.notFound.seoTitle} headerTheme="light" noindex>
  <section class="notfound sec-green">
    <div class="container-narrow text-center">
      <img src="/media/logo-white.png" alt="" class="mark" aria-hidden="true" />
      <p class="four">404</p>
      <h1>{t.notFound.heading}</h1>
      <p class="lead">{t.notFound.lead}</p>
      <div class="actions">
        <a href={localize('/', lang)} class="btn btn-amber">{t.ui.returnHome}</a>
        <a href={localize('/blog', lang)} class="btn btn-outline-light">{t.ui.readPramana}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { min-height: 80vh; display: flex; align-items: center; padding-top: 8rem; }
  .mark { width: 64px; margin: 0 auto 1.5rem; opacity: 0.9; }
  .four { font-family: var(--display); font-weight: 700; letter-spacing: 0.3em; color: var(--amber); margin: 0 0 0.5rem; }
  .notfound h1 { color: #fff; }
  .notfound .lead { color: rgba(255,255,255,0.82); max-width: 46ch; margin-inline: auto; margin-bottom: 2rem; }
  .actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
