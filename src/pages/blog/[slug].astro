---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import posts from '../../data/blog.json';

export function getStaticPaths() {
  return posts.map((p, i) => ({
    params: { slug: p.slug },
    props: { post: p, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const fmt = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.title} description={post.excerpt || undefined} image={post.hero ? `/media/${post.hero}` : undefined} headerTheme="light">
  <section class="post-hero" style={post.hero ? `background-image:url(/media/${post.hero})` : undefined}>
    <div class="post-hero-overlay"></div>
    <div class="container post-hero-inner">
      <a href="/blog" class="back">← PRĀMAṆA</a>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <span>{fmt(post.date)}</span>
        {post.tags && post.tags.length > 0 && (
          <span class="post-tags">{post.tags.map((t) => <span class="tag">{t}</span>)}</span>
        )}
      </div>
    </div>
  </section>

  <section class="post-body">
    <article class="prose">
      <Blocks blocks={post.blocks} />
    </article>

    <div class="container-narrow post-cta">
      <a href="/events" class="btn btn-green">Practice with me</a>
      <a href="/blog" class="btn btn-outline">More writing</a>
    </div>

    <nav class="project-nav container">
      {prev
        ? <a href={`/blog/${prev.slug}`} class="pn prev"><span>← Previous</span><strong>{prev.title}</strong></a>
        : <span></span>}
      {next
        ? <a href={`/blog/${next.slug}`} class="pn next"><span>Next →</span><strong>{next.title}</strong></a>
        : <span></span>}
    </nav>
  </section>
</Base>

<style>
  .post-hero { position: relative; min-height: 46vh; display: flex; align-items: flex-end; background-size: cover; background-position: center; color: #fff; background-color: var(--green-deep); }
  .post-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,26,16,0.85), rgba(20,26,16,0.3)); }
  .post-hero-inner { position: relative; padding-block: 2.5rem 3rem; max-width: 820px; }
  .back { display: inline-block; margin-bottom: 1rem; font-family: var(--display); font-weight: 500; letter-spacing: 0.06em; color: var(--amber); }
  .post-hero h1 { color: #fff; max-width: 22ch; }
  .post-meta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-family: var(--display); font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.9; }
  .post-tags { display: flex; gap: 0.4rem; }
  .tag { background: rgba(255,255,255,0.16); padding: 0.2em 0.7em; border-radius: 999px; font-size: 0.72rem; }

  .post-body { background: var(--cream); }
  .post-cta { display: flex; gap: 1rem; margin-top: 3rem; flex-wrap: wrap; justify-content: center; }
  .project-nav { display: flex; justify-content: space-between; gap: 1rem; padding-block: 3rem 1rem; margin-top: 2rem; border-top: 1px solid var(--border); }
  .pn { display: flex; flex-direction: column; gap: 0.25rem; max-width: 45%; }
  .pn.next { text-align: right; margin-left: auto; }
  .pn span { font-size: 0.8rem; color: var(--amber-dark); font-family: var(--display); font-weight: 500; }
  .pn strong { font-family: var(--display); font-weight: 400; color: var(--green); }
  .pn:hover strong { color: var(--amber-dark); }
</style>
