---
import Base from '../../layouts/Base.astro';
import { localePaths, localize, useTranslations, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const paras = Object.values(t.about.paras);
---
<Base
  lang={lang}
  title={t.about.seoTitle}
  description={t.about.seoDescription}
  image="/media/dsc01432-copy.jpeg"
  headerTheme="dark"
>
  <section class="about sec-yellow">
    <div class="container about-grid">
      <div class="about-text">
        <p class="eyebrow">{t.about.eyebrow}</p>
        <h1>{t.about.heading}</h1>
        <p class="role">{t.about.role}</p>
        <p class="intro">{t.about.intro}</p>
        {paras.map((p) => <p class="reveal">{p}</p>)}
        <div class="about-cta">
          <a href={localize('/events', lang)} class="btn btn-green">{t.ui.practiceWithMe}</a>
          <a href={localize('/jango-project', lang)} class="btn btn-dark">{t.about.ctaJango}</a>
        </div>
      </div>
      <div class="about-photo">
        <img src="/media/dsc01432-copy.jpeg" alt={t.about.photoAlt} loading="eager" />
      </div>
    </div>
  </section>
</Base>

<style>
  .about { padding-top: 8rem; }
  .about-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 3.5rem; align-items: start; }
  .about-text { max-width: 60ch; }
  .about-text .eyebrow {
    font-family: var(--display); font-size: 0.78rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--green-deep); margin-bottom: 0.6rem;
  }
  .about-text h1 { margin-bottom: 0.25em; }
  .about-text .role {
    font-family: var(--display); font-size: 0.95rem; font-weight: 500;
    color: var(--green-deep); margin-bottom: 1.25em; line-height: 1.45;
  }
  .about-text .intro { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 400; line-height: 1.4; margin-bottom: 1.5em; }
  .about-text p { color: #1c1c18; }
  .about-text .reveal { font-size: 0.98rem; }
  .about-photo { position: sticky; top: 6rem; }
  .about-photo img { width: 100%; border-radius: 4px; filter: grayscale(1) contrast(1.03); aspect-ratio: 3/4; object-fit: cover; }
  .about-cta { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .btn-dark { background: var(--ink); color: #fff; }
  .btn-dark:hover { background: #000; }
  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-photo { position: static; order: -1; max-width: 360px; }
  }
</style>
