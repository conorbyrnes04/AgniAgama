---
import Base from '../../layouts/Base.astro';
import Wave from '../../components/Wave.astro';
import { site } from '../../data/site';
import { localePaths, useTranslations, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const app = site.external.pratibha;

// Copy comes from the dictionary; each layer's glyph lives here.
const layers = [
  { glyph: 'fire', ...t.pratibha.layers.original },
  { glyph: 'air', ...t.pratibha.layers.translation },
  { glyph: 'sage', ...t.pratibha.layers.commentary },
  { glyph: 'celtic-key', ...t.pratibha.layers.terms },
  { glyph: 'infinity', ...t.pratibha.layers.resonances },
  { glyph: 'lotus', ...t.pratibha.layers.practice },
];
const features = Object.values(t.pratibha.features);
// The text names stay as they are; only the trailing "and more" is translated.
const traditions = [
  'Upaniṣads',
  'Tao Te Ching',
  'Heraclitus',
  "Patañjali's Yoga Sūtras",
  'Kashmir Śaivism',
  'Buddhism',
  t.pratibha.tradMore,
];
---
<Base
  lang={lang}
  title={t.pratibha.seoTitle}
  description={t.pratibha.seoDescription}
  headerTheme="light"
>
  <!-- Hero -->
  <section class="pr-hero sec-green">
    <div class="container pr-hero-grid">
      <div class="pr-hero-copy">
        <p class="eyebrow">{t.pratibha.eyebrow}</p>
        <h1>{t.pratibha.heading}</h1>
        <p class="lead">{t.pratibha.lead}</p>
        <div class="pr-actions">
          <a href={app} target="_blank" rel="noopener" class="btn btn-amber">{t.pratibha.open}</a>
          <a href="#about-pratibha" class="btn btn-outline-light">{t.pratibha.whatIsIt}</a>
        </div>
      </div>
      <a href={app} target="_blank" rel="noopener" class="pr-preview reveal" aria-label={t.pratibha.open}>
        <img src="/media/pratibha-preview.jpg" alt={t.pratibha.previewAlt} loading="eager" />
      </a>
    </div>
  </section>

  <!-- What it is -->
  <section id="about-pratibha" class="pr-intro sec-cream">
    <div class="container-narrow text-center">
      <p class="eyebrow">{t.pratibha.introEyebrow}</p>
      <h2>{t.pratibha.introTitle}</h2>
      <p class="lead" set:html={t.pratibha.introLeadHtml} />
    </div>
  </section>

  <!-- Layered reading -->
  <section class="pr-layers sec-sand">
    <div class="container">
      <p class="eyebrow text-center">{t.pratibha.layersEyebrow}</p>
      <h2 class="text-center">{t.pratibha.layersTitle}</h2>
      <div class="layer-grid">
        {layers.map((l, i) => (
          <div class="layer reveal">
            <span class="layer-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <img
              class="layer-glyph"
              src={`/media/glyphs/${l.glyph}.svg`}
              alt=""
              width="48"
              height="48"
              loading="lazy"
            />
            <h3>{l.title}</h3>
            <p>{l.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Traditions -->
  <section class="pr-trad sec-cream">
    <div class="container-narrow text-center">
      <p class="eyebrow">{t.pratibha.tradEyebrow}</p>
      <h2>{t.pratibha.tradTitle}</h2>
      <p class="lead">{t.pratibha.tradLead}</p>
      <ul class="trad-list">
        {traditions.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <!-- Companion -->
  <section class="pr-companion sec-cream">
    <div class="container pr-comp-grid">
      <div>
        <h2>{t.pratibha.companionTitle}</h2>
        <p set:html={t.pratibha.companionHtml} />
        <a href={app} target="_blank" rel="noopener" class="btn btn-green">{t.pratibha.companionCta}</a>
      </div>
      <ul class="feat-list">
        {features.map((f) => <li><strong>{f.strong}</strong>{f.rest}</li>)}
      </ul>
    </div>
  </section>

  <Wave color="var(--green-deep)" />
  <!-- CTA -->
  <section class="pr-cta sec-green">
    <div class="container-narrow text-center">
      <h2>{t.pratibha.ctaTitle}</h2>
      <p class="lead">{t.pratibha.ctaLead}</p>
      <a href={app} target="_blank" rel="noopener" class="btn btn-amber">{t.pratibha.ctaOpen}</a>
    </div>
  </section>
</Base>

<style>
  .pr-hero { padding-top: 8rem; }
  .pr-hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3rem; align-items: center; }
  .pr-hero-copy .eyebrow { color: var(--amber); }
  .pr-hero-copy h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
  .pr-hero-copy .lead { color: rgba(255,255,255,0.85); }
  .pr-actions { display: flex; gap: 1rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .pr-preview { display: block; border-radius: 8px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.12); }
  .pr-preview img { width: 100%; display: block; transition: transform 0.5s ease; }
  .pr-preview:hover img { transform: scale(1.03); }

  .pr-intro em { font-style: italic; color: var(--green); }

  .layer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem 2rem;
    margin-top: 2.8rem;
  }
  .layer {
    position: relative;
    padding: 1.4rem 0 0.2rem;
    border-top: 1px solid rgba(52, 71, 52, 0.22);
  }
  .layer-index {
    position: absolute;
    top: 1.35rem;
    right: 0;
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--amber-dark);
    opacity: 0.75;
  }
  .layer-glyph {
    width: 2.6rem;
    height: 2.6rem;
    object-fit: contain;
    margin-bottom: 0.85rem;
    /* Tint black ink glyphs to Agni amber */
    filter: invert(62%) sepia(72%) saturate(650%) hue-rotate(352deg) brightness(98%) contrast(95%);
  }
  .layer h3 {
    margin: 0 0 0.45rem;
    color: var(--green);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
  }
  .layer p {
    font-weight: 300;
    margin: 0;
    color: #4a4a42;
    max-width: 28ch;
  }

  .trad-list { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
  .trad-list li { font-family: var(--display); font-weight: 500; background: var(--sand); color: var(--green); padding: 0.5em 1.1em; border-radius: 999px; }

  .pr-comp-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
  .pr-comp-grid h2 { color: var(--green); }
  .pr-comp-grid strong { color: var(--green-deep); }
  .feat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .feat-list li { padding: 0.9rem 1.1rem; background: #fff; border: 1px solid var(--border); border-radius: 6px; font-weight: 300; }
  .feat-list strong { font-family: var(--display); font-weight: 600; color: var(--green); }

  .pr-cta .lead { color: rgba(255,255,255,0.85); margin-bottom: 1.8rem; }

  @media (max-width: 860px) {
    .pr-hero-grid, .pr-comp-grid { grid-template-columns: 1fr; }
    .layer-grid { grid-template-columns: 1fr; gap: 1.8rem; }
    .layer p { max-width: none; }
  }
</style>
