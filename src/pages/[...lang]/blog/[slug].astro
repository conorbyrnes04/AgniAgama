---
import Base from '../../../layouts/Base.astro';
import Blocks from '../../../components/Blocks.astro';
import { site } from '../../../data/site';
import { getPosts, isUntranslated, postLocales, type Post } from '../../../i18n/blog';
import {
  defaultLocale,
  fill,
  locales,
  localeKeys,
  localize,
  useTranslations,
  type Locale,
} from '../../../i18n';

// One page per (language × post).
export function getStaticPaths() {
  return localeKeys.flatMap((lang) => {
    const posts = getPosts(lang);
    return posts.map((p, i) => ({
      params: { lang: locales[lang].path || undefined, slug: p.slug },
      props: { lang, post: p, prev: posts[i - 1], next: posts[i + 1] },
    }));
  });
}

const { lang, post, prev, next } = Astro.props as {
  lang: Locale;
  post: Post;
  prev?: Post;
  next?: Post;
};
const t = useTranslations(lang);
const fmt = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString(locales[lang].code, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const origin = Astro.site?.origin ?? site.url;
const postUrl = new URL(localize(`/blog/${post.slug}`, lang), origin).href;
const heroPath = post.hero ? `/media/${post.hero}` : site.defaultOgImage;
const description =
  post.excerpt?.trim() || fill(t.post.fallbackDescription, { title: post.title });
// Only advertise the languages this essay actually exists in, and point an
// untranslated copy at the English original so it isn't read as duplicate
// content — the page still exists so navigation never dead-ends.
const alternateLocales = postLocales(post.slug);
const untranslated = isUntranslated(post.slug, lang);
const canonical = untranslated ? localize(`/blog/${post.slug}`, defaultLocale) : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: site.person.name,
    url: new URL(localize('/about', lang), origin).href,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/media/logo.png', origin).href,
    },
  },
  image: new URL(heroPath, origin).href,
  mainEntityOfPage: postUrl,
  url: postUrl,
  inLanguage: locales[lang].code,
};
---
<Base
  lang={lang}
  alternateLocales={alternateLocales}
  canonical={canonical}
  title={post.title}
  description={description}
  image={heroPath}
  ogType="article"
  jsonLd={articleJsonLd}
  headerTheme="light"
>
  <section class="post-hero" style={post.hero ? `background-image:url(/media/${post.hero})` : undefined}>
    <div class="post-hero-overlay"></div>
    <div class="container post-hero-inner">
      <a href={localize('/blog', lang)} class="back">{t.post.back}</a>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <span>{t.ui.by} <a href={localize('/about', lang)}>{site.person.name}</a></span>
        <span>{fmt(post.date)}</span>
        {post.tags && post.tags.length > 0 && (
          <span class="post-tags">{post.tags.map((tag) => <span class="tag">{tag}</span>)}</span>
        )}
      </div>
    </div>
  </section>

  <section class="post-body">
    {untranslated && (
      <p class="untranslated container-narrow" lang="en">{t.post.onlyInEnglish}</p>
    )}
    <article class="prose">
      <Blocks blocks={post.blocks} />
    </article>

    <div class="container-narrow post-cta">
      <a href={localize('/events', lang)} class="btn btn-green">{t.ui.practiceWithMe}</a>
      <a href={localize('/blog', lang)} class="btn btn-outline">{t.ui.moreWriting}</a>
    </div>

    <nav class="project-nav container">
      {prev
        ? <a href={localize(`/blog/${prev.slug}`, lang)} class="pn prev"><span>{t.ui.previous}</span><strong>{prev.title}</strong></a>
        : <span></span>}
      {next
        ? <a href={localize(`/blog/${next.slug}`, lang)} class="pn next"><span>{t.ui.next}</span><strong>{next.title}</strong></a>
        : <span></span>}
    </nav>
  </section>
</Base>

<style>
  .post-hero { position: relative; min-height: 46vh; display: flex; align-items: flex-end; background-size: cover; background-position: center; color: #fff; background-color: var(--green-deep); }
  .post-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,26,16,0.85), rgba(20,26,16,0.3)); }
  .post-hero-inner { position: relative; padding-block: 2.5rem 3rem; max-width: 820px; }
  .back { display: inline-block; margin-bottom: 1rem; font-family: var(--display); font-weight: 500; letter-spacing: 0.06em; color: var(--amber); }
  .post-hero h1 { color: #fff; max-width: 22ch; }
  .post-meta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-family: var(--display); font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.9; }
  .post-meta a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }
  .post-tags { display: flex; gap: 0.4rem; }
  .tag { background: rgba(255,255,255,0.16); padding: 0.2em 0.7em; border-radius: 999px; font-size: 0.72rem; }

  .post-body { background: var(--cream); }
  .untranslated {
    margin: 0 auto; padding-top: 2.5rem; font-family: var(--display);
    font-size: 0.85rem; letter-spacing: 0.04em; color: var(--green); opacity: 0.8;
  }
  .post-cta { display: flex; gap: 1rem; margin-top: 3rem; flex-wrap: wrap; justify-content: center; }
  .project-nav { display: flex; justify-content: space-between; gap: 1rem; padding-block: 3rem 1rem; margin-top: 2rem; border-top: 1px solid var(--border); }
  .pn { display: flex; flex-direction: column; gap: 0.25rem; max-width: 45%; }
  .pn.next { text-align: right; margin-left: auto; }
  .pn span { font-size: 0.8rem; color: var(--amber-dark); font-family: var(--display); font-weight: 500; }
  .pn strong { font-family: var(--display); font-weight: 400; color: var(--green); }
  .pn:hover strong { color: var(--amber-dark); }
</style>
